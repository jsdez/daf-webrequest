{
  "name": "daf-webrequest",
  "version": "1.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run bump:plugin-version && tsc",
    "bump:plugin-version": "node scripts/bump-version.mjs",
    "bundle": "node build.mjs",
    "bundle:plugin": "esbuild src/plugin.ts --bundle --minify --format=esm --target=es2017 --platform=browser --outfile=dist/plugin.bundle.js",
    "build:plugin": "npm run build && npm run bundle:plugin",
    "build:test": "npm run typecheck && node scripts/build-test.mjs",
    "deploy": "npm run build && npm run bundle"
  },
  "keywords": [],
  "author": "DAF Trucks N.V.",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.0.1",
    "esbuild": "^0.25.5",
    "tsx": "^4.23.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@nintex/form-plugin-contract": "^1.0.5",
    "lit": "^3.3.0"
  }
}
